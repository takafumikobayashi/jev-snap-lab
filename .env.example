# TypeSafe API の Bearer key。サーバー専用。ブラウザへ渡さない。
TYPESAFE_API_KEY=your_server_side_key

# 既定モデル。デモは jev-latest、回帰テストは jev-1.13.0 のような versioned ID を明示する。
TYPESAFE_DEFAULT_MODEL=jev-latest

# SDK の API root。通常は未設定のまま既定値を使う。
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Jev 呼び出しの 1 試行 timeout (ms)。SDK 既定は 10000。
# SDK に総 retry 予算は存在せず、この値は 1 試行あたりにしか効かない。
JEV_TIMEOUT_MS=3500

# retry を含む総予算 (ms)。AbortSignal によるハード上限で、
# SDK の設定ではなくアプリ側で強制する。アダプタの maxDuration より小さいこと。
#
# 通常時は 3500 x 3 試行 + backoff (500 + 1000) = 12000 でちょうど 3 試行が収まる。
# ただし 3 試行の完了は保証されない。SDK は Retry-After を最大 60 秒まで
# 尊重するため、上流が長い待機を指示すると 1 試行目の後で予算を使い切る。
# その場合は AbortSignal が Retry-After の待機ごと中断し、504 を返す。
# 1回の判定に使える総時間（retry の待機を含む）。
# リクエスト全体の上限 16,000ms（+server.ts の REQUEST_BUDGET_MS）で
# 頭打ちになるため、これより大きい値を設定しても効かない。
# 上限は Vercel の maxDuration 20,000ms から逆算している。
JEV_TOTAL_TIMEOUT_MS=12000

# コスト推計の単価 (USD / 1M input tokens)。output tokens は無料。
JEV_INPUT_PRICE_PER_MILLION_TOKENS=0.042

# アプリ側の best-effort レート制限。serverless では完全な制限にならない。
# 正の整数のみ。読めない値（0、-1、2/min など）は既定の 10 へ戻り、
# サーバーログに RATE_LIMIT_INVALID が出る。
APP_RATE_LIMIT_PER_MINUTE=10

# CITY Semantic Fit（実験機能）を有効にする。既定は無効。
# 有効にすると1リクエストで上流を2回呼び、待ち時間が約1.5〜1.8倍になる。
# 結果は画面に出さず、観測ログだけを残す。
CITY_SEMANTIC_EXPERIMENT=false

# SPEC FIND（実験機能）を有効にする。既定は無効。
# 明示的な "true" だけを有効とする。1 や TRUE では有効にならない。
SPEC_FIND_ENABLED=false

# OGP の絶対 URL を組み立てるためのサイトの起点。
# OGP は絶対 URL を要求するため、未設定なら og:image と og:url の meta を
# 出力しない。壊れた相対 URL を出すより、出さない方が設定漏れに気付ける。
# 手元で OGP を確認するときは http://localhost:5173 のように設定する。
# PUBLIC_SITE_URL=https://example.com

# CITY が使うデータセット名 (data/city/<名前>.json)。
# 未設定なら架空データ fictional-m-city を使う。実在の自治体データは
# リポジトリに含めず、手元で精度を確認するときだけ指定する。
#
# 値を変えたら開発サーバーを再起動すること。シェルでのインライン指定
# （CITY_DIRECTORY=... pnpm dev）でも上書きできる。
# CITY_DIRECTORY=fictional-m-city

# 出典 URL に許可するホスト（カンマ区切り）。
# 未設定なら URL を持つ出典を一切許さない。架空データは URL を持たない
# ため公開時は未設定でよい。実データを手元で表示するときだけ設定する。
# CITY_SOURCE_HOSTS=example.test,another.test

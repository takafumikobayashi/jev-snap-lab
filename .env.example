# TypeSafe API の Bearer key。サーバー専用。ブラウザへ渡さない。
TYPESAFE_API_KEY=your_server_side_key

# 既定モデル。デモは jev-latest、回帰テストは jev-1.13.0 のような versioned ID を明示する。
TYPESAFE_DEFAULT_MODEL=jev-latest

# SDK の API root。通常は未設定のまま既定値を使う。
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Jev 呼び出しの 1 試行 timeout (ms)。SDK 既定は 10000。
# SDK に総 retry 予算は存在せず、この値は 1 試行あたりにしか効かない。
JEV_TIMEOUT_MS=3500

# retry を含む総予算 (ms)。AbortSignal によるハード上限で、
# SDK の設定ではなくアプリ側で強制する。アダプタの maxDuration より小さいこと。
#
# 通常時は 3500 x 3 試行 + backoff (500 + 1000) = 12000 でちょうど 3 試行が収まる。
# ただし 3 試行の完了は保証されない。SDK は Retry-After を最大 60 秒まで
# 尊重するため、上流が長い待機を指示すると 1 試行目の後で予算を使い切る。
# その場合は AbortSignal が Retry-After の待機ごと中断し、504 を返す。
JEV_TOTAL_TIMEOUT_MS=12000

# コスト推計の単価 (USD / 1M input tokens)。output tokens は無料。
JEV_INPUT_PRICE_PER_MILLION_TOKENS=0.042

# アプリ側の best-effort レート制限。serverless では完全な制限にならない。
APP_RATE_LIMIT_PER_MINUTE=10
